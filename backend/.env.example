# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# ─── MetaAPI (MT5 real sync) ─────────────────────────────
# Get your token at: https://app.metaapi.cloud/token
# Free tier: 1 MT5 account included
METAAPI_TOKEN=your-metaapi-token

# ─── Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Cashfree Payments ──────────────────────────────────
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
CASHFREE_ENV=sandbox

# ─── URLs ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ─── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Email notifications (Gmail SMTP — interim until custom domain) ─────
# 1. Turn on 2-Step Verification on the Gmail account you want to send from
# 2. Generate an App Password: myaccount.google.com/apppasswords
# 3. Paste that 16-character password below (NOT your normal Gmail password)
# Leave unset to disable email notifications — the backend no-ops instead of failing.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ─── Trade Replay market data ───────────────────────────
# Crypto, gold, silver, WTI/Brent crude and natural gas work out of the box —
# they use Binance's public market data (no key). Host the backend in Asia/EU:
# Binance rejects some US server IPs (HTTP 451).
# Forex pairs (EURUSD, GBPJPY, …) need a Twelve Data key. Its free Basic plan is
# for evaluation / non-commercial use; a paid product needs a business plan.
# Leave unset to disable forex replay.
TWELVEDATA_API_KEY=

# ─── News page ──────────────────────────────────────────────────────────
# Works out of the box with free public RSS feeds + Gemini (GEMINI_API_KEY above)
# + Binance public prices — no key needed. Optionally add more headlines from
# Finnhub's free market-news endpoint (free key at finnhub.io; its free plan is
# for personal / non-commercial use — re-check terms before charging users).
FINNHUB_API_KEY=
# How often the shared news cache refreshes, in minutes (default 15, min 5).
NEWS_TTL_MINUTES=15

# ─── Economic Calendar ─────────────────────────────────
# Schedule, impact, forecast and previous come from the free Forex Factory feed (no key).
# FREE official sources for the "Actual" value of US releases. They run on the server, so actuals show
# up even when nobody has the MT5 EA connected. Each needs a free key:
#   BLS  (jobs, unemployment, CPI, PPI)   https://data.bls.gov/registrationEngine/   (renew yearly)
#   FRED (claims, retail sales, trade, PCE, GDP)   https://fred.stlouisfed.org/docs/api/api_key.html
#   EIA  (crude oil inventories, natural gas storage)   https://www.eia.gov/opendata/register.php
# Leave a key blank to switch that source off. Values are never guessed — an unconfirmed actual stays "-".
BLS_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
# How often (seconds) to re-check these sources right after a release (default 15, min 5).
OFFICIAL_ACTUALS_HOT_SECONDS=15
# OPTIONAL: Financial Modeling Prep key, used only for events the official sources leave blank.
# FMP's free Basic plan is end-of-day, so real-time actuals need a paid plan; showing FMP data to your
# own users also requires FMP's data display licence. Leave blank to skip FMP.
FMP_API_KEY=
# How often (seconds) to re-check FMP right after a High/Medium release (default 30, min 5).
ACTUALS_HOT_SECONDS=30
# MT5 calendar feed: comma-separated Supabase user IDs (Supabase → Authentication → Users → UID) whose TradoSync
# terminal may push MetaQuotes calendar actuals to the shared calendar (set InpPushCalendar = true on that terminal
# only). Leave blank to switch the feed off. If a push is refused, the Render log prints the user ID to add.
CALENDAR_FEEDER_USER_IDS=
# How often the shared calendar cache refreshes, in minutes (default 15, min 5).
CALENDAR_TTL_MINUTES=15
