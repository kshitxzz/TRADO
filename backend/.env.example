# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# ─── MetaAPI (MT5 real sync) ─────────────────────────────
# Get your token at: https://app.metaapi.cloud/token
# Free tier: 1 MT5 account included
METAAPI_TOKEN=your-metaapi-token

# ─── Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Cashfree Payments ──────────────────────────────────
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
CASHFREE_ENV=sandbox

# ─── URLs ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ─── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Email notifications (Gmail SMTP — interim until custom domain) ─────
# 1. Turn on 2-Step Verification on the Gmail account you want to send from
# 2. Generate an App Password: myaccount.google.com/apppasswords
# 3. Paste that 16-character password below (NOT your normal Gmail password)
# Leave unset to disable email notifications — the backend no-ops instead of failing.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ─── Trade Replay market data ───────────────────────────
# Crypto, gold, silver, WTI/Brent crude and natural gas work out of the box —
# they use Binance's public market data (no key). Host the backend in Asia/EU:
# Binance rejects some US server IPs (HTTP 451).
# Forex pairs (EURUSD, GBPJPY, …) need a Twelve Data key. Its free Basic plan is
# for evaluation / non-commercial use; a paid product needs a business plan.
# Leave unset to disable forex replay.
TWELVEDATA_API_KEY=
